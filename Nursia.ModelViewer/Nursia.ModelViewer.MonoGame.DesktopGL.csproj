<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AppMonoGameTargetFramework)</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <RootNamespace>Nursia.ModelViewer</RootNamespace>
    <AssemblyName>nrs-mv</AssemblyName>
    <PackageId>nrs-mv</PackageId>
    <ToolCommandName>nrs-mv</ToolCommandName>
    <OutputPath>bin\MonoGame\$(Configuration)</OutputPath>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(AppMonoGameVersion)" />
    <PackageReference Include="Myra" Version="$(MyraVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nursia\Nursia.MonoGame.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>

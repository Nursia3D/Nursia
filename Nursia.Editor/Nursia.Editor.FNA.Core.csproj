<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(FNATargetFramework)</TargetFramework>
    <RootNamespace>Nursia.Editor</RootNamespace>
    <AssemblyName>nrs-editor</AssemblyName>
    <PackageId>nrs-editor</PackageId>
    <ToolCommandName>nrs-editor</ToolCommandName>
    <OutputPath>bin\FNA.Core\$(Configuration)</OutputPath>
    <DefineConstants>$(DefineConstants);FNA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageWriteSharp" Version="$(StbImageWriteSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Myra\src\Myra\Myra.FNA.Core.csproj" />
    <ProjectReference Include="..\..\XNAssets\src\XNAssets.FontStashSharp\XNAssets.FontStashSharp.FNA.Core.csproj" />
    <ProjectReference Include="..\Nursia\Nursia.FNA.Core.csproj" />
  </ItemGroup>
</Project>
<Project>
  <PropertyGroup>
    <Authors>NursiaTeam</Authors>
    <Product>Nursia</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/NursiaEngine/Nursia</PackageProjectUrl>
    <Description>MonoGame/FNA library that provides simple 3D model class</Description>
    <RootNamespace>Nursia</RootNamespace>
    <MonoGameTargetFramework>netstandard2.0</MonoGameTargetFramework>
    <AppMonoGameTargetFramework>net8.0</AppMonoGameTargetFramework>
    <FNATargetFramework>net8.0</FNATargetFramework>
    <Version>0.6.1</Version>
    <MonoGameVersion>3.8.0.1641</MonoGameVersion>
    <AppMonoGameVersion>3.8.4.1</AppMonoGameVersion>
    <MyraVersion>1.5.11</MyraVersion>
    <DigitalRiseModelVersion>0.7.2</DigitalRiseModelVersion>
    <XNAssetsVersion>0.8.4</XNAssetsVersion>
    <StbImageWriteSharpVersion>1.16.7</StbImageWriteSharpVersion>
  </PropertyGroup>
</Project>